# Staging environment for docker-compose.prod.yml. Copy to .env on the VPS and chmod 600 .env.
# Replace every change-me value and example hostname before starting. Never commit the .env copy.
# Generate distinct URL-safe secrets with: openssl rand -hex 32

# HTTPS: set a DNS hostname pointing at the VPS; Caddy obtains a public certificate on ports 80/443.
APP_DOMAIN=staging.example.com
ALLOWED_ORIGINS=https://staging.example.com
ENVIRONMENT=production
HTTP_PORT=80
HTTPS_PORT=443
APP_UID=1000

# PostgreSQL is internal to Docker; do not publish its port.
POSTGRES_USER=sap_assistant
POSTGRES_PASSWORD=change-me-staging-postgres-superuser
POSTGRES_DB=sap_assistant
SAP_BRIM_DB_PASSWORD=change-me-staging-app-password
DATABASE_URL=postgresql://sap_brim_ai:change-me-staging-app-password@postgres:5432/sap_brim_ai
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication. Set a unique JWT secret and a private staging admin account.
JWT_SECRET=change-me-staging-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
SUPER_ADMIN_EMAIL=admin@staging.example.com
SUPER_ADMIN_PASSWORD=change-me-staging-admin-password
ADMIN_API_KEY=
REGISTRATION_ENABLED=False
DEFAULT_ACCESS_GROUP=all

# Use only the explicitly approved OpenRouter provider for staging.
# Create a fresh key; never reuse a key that appeared in repository history or an old .env.
LLM_PROVIDER=openrouter
LLM_ALLOWED_PROVIDERS=openrouter
OPENROUTER_API_KEY=
LLM_ALLOW_FREE_TIER=True
LLM_OPENROUTER_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free
WEB_FALLBACK_ENABLED=False

# Keep the image model aligned with the vector dimension and build-time model.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
INCLUDE_SELF_AUTHORED_DOCS=False
VITE_API_BASE_URL=
